{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "files.exclude": {
        "**/.venv": false,
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/__pycache__/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/build": true,
        "**/dist": true,
        "**/__pycache__": true
    }
}
